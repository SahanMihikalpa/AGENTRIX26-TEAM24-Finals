// GovGuide frontend — standalone deploy pipeline.
//
// Builds and redeploys only the frontend container via the root
// docker-compose.yml (`--no-deps` so the backend container is left alone).
// NEXT_PUBLIC_API_BASE is inlined at build time, so this pipeline must know
// BACKEND_PORT even though it never touches the backend container.
//
// Runs on the same host that serves the containers — Jenkins' own service
// account must be in the `docker` group (see ../DOCKER.md).

pipeline {
    agent any

    environment {
        PUBLIC_HOST   = '10.50.227.200'
        FRONTEND_PORT = '3001'
        BACKEND_PORT  = '8001'
        COMPOSE       = 'docker compose'
    }

    options {
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build frontend image') {
            steps {
                // Rebuild is required (not just a restart) whenever
                // NEXT_PUBLIC_API_BASE or the app source changes — Next
                // inlines it into the client bundle at `next build`.
                sh '${COMPOSE} build frontend'
            }
        }

        stage('Deploy frontend') {
            steps {
                sh '${COMPOSE} up -d --no-deps frontend'
            }
        }

        stage('Health check') {
            steps {
                sh '''
                    set -e
                    for i in $(seq 1 15); do
                        if curl -fsS "http://127.0.0.1:${FRONTEND_PORT}/" > /dev/null; then
                            echo "frontend healthy"
                            exit 0
                        fi
                        [ "$i" -eq 15 ] && { echo "frontend failed health check"; exit 1; }
                        sleep 2
                    done
                '''
            }
        }
    }

    post {
        always {
            sh '${COMPOSE} ps frontend'
        }
        failure {
            sh '${COMPOSE} logs --tail=150 frontend'
        }
    }
}
