pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'GIT_REPO_URL', defaultValue: 'https://github.com/SahanMihikalpa/AGENTRIX26-TEAM24-Finals.git', description: 'Repo URL (monorepo — this job only builds frontend/)')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Branch to deploy')
        string(name: 'IMAGE_NAME', defaultValue: 'govguide-frontend:latest', description: 'Docker image name')
        string(name: 'CONTAINER_NAME', defaultValue: 'govguide-frontend', description: 'Docker container name')
        string(name: 'HOST_PORT', defaultValue: '3001', description: 'Host port published for the frontend')
        string(name: 'NEXT_PUBLIC_API_BASE', defaultValue: 'http://10.50.227.200:8001', description: 'Backend URL as seen by the browser — baked into the client bundle at build time')
    }

    environment {
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.GIT_BRANCH}",
                    url: "${params.GIT_REPO_URL}",
                    credentialsId: 'github-credentials'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh """
                    docker build \\
                      --build-arg NEXT_PUBLIC_API_BASE=${params.NEXT_PUBLIC_API_BASE} \\
                      --build-arg NEXT_PUBLIC_USE_MOCK=false \\
                      -t ${params.IMAGE_NAME} \\
                      frontend
                """
            }
        }

        stage('Deploy Container') {
            steps {
                sh "docker rm -f ${params.CONTAINER_NAME} || true"
                sh """
                    docker run -d --name ${params.CONTAINER_NAME} \\
                      -p ${params.HOST_PORT}:3000 \\
                      --restart unless-stopped \\
                      ${params.IMAGE_NAME}
                """
            }
        }

        stage('Health check') {
            steps {
                sh """
                    for i in \$(seq 1 15); do
                        if curl -fsS http://127.0.0.1:${params.HOST_PORT}/ > /dev/null; then
                            echo frontend healthy
                            exit 0
                        fi
                        sleep 2
                    done
                    echo frontend failed health check
                    exit 1
                """
            }
        }
    }

    post {
        failure {
            sh "docker logs --tail=150 ${params.CONTAINER_NAME} || true"
            echo 'Build or deployment failed. Check the console output for the exact Docker or Git error.'
        }
        success {
            echo "Frontend image built and deployed successfully on port ${params.HOST_PORT}."
        }
    }
}
