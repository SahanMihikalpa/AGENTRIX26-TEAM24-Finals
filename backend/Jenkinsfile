pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'GIT_REPO_URL', defaultValue: 'https://github.com/SahanMihikalpa/AGENTRIX26-TEAM24-Finals.git', description: 'Repo URL (monorepo — this job only builds backend/)')
        string(name: 'GIT_BRANCH', defaultValue: 'main', description: 'Branch to deploy')
        string(name: 'IMAGE_NAME', defaultValue: 'govguide-backend:latest', description: 'Docker image name')
        string(name: 'CONTAINER_NAME', defaultValue: 'govguide-backend', description: 'Docker container name')
        string(name: 'HOST_PORT', defaultValue: '8001', description: 'Host port published for the backend')
        string(name: 'CORS_ORIGIN', defaultValue: 'http://10.50.227.200:3001', description: 'Frontend origin allowed to call this API')
    }

    environment {
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: "${params.GIT_BRANCH}",
                    url: "${params.GIT_REPO_URL}",
                    credentialsId: 'github-credentials'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh "docker build -t ${params.IMAGE_NAME} backend"
            }
        }

        stage('Deploy Container') {
            steps {
                // Every other setting has a working default in
                // app/infrastructure/config.py — only the three provider keys
                // need real values, so they're the only secrets this job needs.
                withCredentials([
                    string(credentialsId: 'gemini-api-key', variable: 'GEMINI_API_KEY'),
                    string(credentialsId: 'groq-api-key',   variable: 'GROQ_API_KEY'),
                    string(credentialsId: 'tavily-api-key', variable: 'TAVILY_API_KEY')
                ]) {
                    sh "docker rm -f ${params.CONTAINER_NAME} || true"
                    sh """
                        docker run -d --name ${params.CONTAINER_NAME} \\
                          -p ${params.HOST_PORT}:8000 \\
                          -e HOST=0.0.0.0 \\
                          -e PORT=8000 \\
                          -e CORS_ORIGINS=${params.CORS_ORIGIN} \\
                          -e GEMINI_API_KEY=\$GEMINI_API_KEY \\
                          -e GROQ_API_KEY=\$GROQ_API_KEY \\
                          -e TAVILY_API_KEY=\$TAVILY_API_KEY \\
                          -v \$(pwd)/backend/data:/app/data \\
                          --restart unless-stopped \\
                          ${params.IMAGE_NAME}
                    """
                }
            }
        }

        stage('Health check') {
            steps {
                sh """
                    for i in \$(seq 1 20); do
                        if curl -fsS http://127.0.0.1:${params.HOST_PORT}/health > /dev/null; then
                            echo backend healthy
                            exit 0
                        fi
                        sleep 3
                    done
                    echo backend failed health check
                    exit 1
                """
            }
        }
    }

    post {
        failure {
            sh "docker logs --tail=150 ${params.CONTAINER_NAME} || true"
            echo 'Build or deployment failed. Check the console output for the exact Docker or Git error.'
        }
        success {
            echo "Backend image built and deployed successfully on port ${params.HOST_PORT}."
        }
    }
}
