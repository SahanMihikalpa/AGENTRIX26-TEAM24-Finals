# GovGuide backend — environment template.
# Copy to `.env` and fill in secrets. `.env` is gitignored; this template is not.

# ── App ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# ── Local data stores (paths are relative to backend/) ─────────────
DATA_DIR=data
SQLITE_PATH=data/govguide.sqlite3
CHROMA_DIR=data/chroma
SOURCE_POOL_DIR=data/source_pool

# ── LLM (free tier; fill when keys are available) ──────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# ── Web research (fallback path) ───────────────────────────────────
TAVILY_API_KEY=
# Official domains for live web search (comma-separated). gov.lk covers every
# *.gov.lk subdomain incl. the gazette/acts portal documents.gov.lk; parliament.lk
# is the official (non-gov.lk) Parliament site.
WEB_ALLOWLIST=gov.lk,documents.gov.lk,parliament.lk,police.lk
# Subset searched first so the gazette / acts surface ahead of general portals.
WEB_PRIORITY_DOMAINS=documents.gov.lk
# When the allow-listed search finds nothing, search the wider web anyway. Those
# results are recorded as unofficial and capped below CONFIDENCE_THRESHOLD, so the
# serving gate always refuses them and they surface in the moderation queue for a
# human instead. Set to false to keep research strictly inside WEB_ALLOWLIST.
WEB_FALLBACK_UNRESTRICTED=true
UNOFFICIAL_MAX_CONFIDENCE=0.5
# Download + parse a PDF a web result links to, so B1 ingests the full document
# instead of its one-line snippet. PDF-only, with size/timeout/magic-byte guards.
WEB_PDF_FETCH=true
# Source authority for gathered web knowledge (confidence = authority * certainty).
# Official (allow-listed) findings can clear the serving gate (labelled pending);
# unofficial ones stay below it and reach a moderator.
WEB_OFFICIAL_AUTHORITY=0.75
WEB_UNOFFICIAL_AUTHORITY=0.5

# ── Embeddings (local, no API) ─────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── RAG guardrails ─────────────────────────────────────────────────
# Confidence serving gate (AD-8 / docs 05). Below this, auto_gathered facts
# are NOT rendered — the graceful fallback is returned instead.
CONFIDENCE_THRESHOLD=0.6
# Self-expanding RAG loop cap (AD-2 / docs 03).
MAX_ACQUISITION_LOOPS=2

# ── LLM gateway (outbound provider pacing, AD-10) ──────────────────
LLM_RATE_LIMIT_RPM=15

# ── HTTP rate limiting (inbound, per client IP) ────────────────────
# The gateway above paces outbound calls but never refuses them, so unbounded
# inbound traffic would still drain the day's free-tier quota. These reject the
# excess at the edge with 429 instead.
CHAT_RATE_LIMIT_RPM=30
API_RATE_LIMIT_RPM=60

# ── Observability (optional) ───────────────────────────────────────
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
