# GovGuide backend — environment template.
# Copy to `.env` and fill in secrets. `.env` is gitignored; this template is not.

# ── App ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# ── Local data stores (paths are relative to backend/) ─────────────
DATA_DIR=data
SQLITE_PATH=data/govguide.sqlite3
CHROMA_DIR=data/chroma
SOURCE_POOL_DIR=data/source_pool

# ── LLM (free tier; fill when keys are available) ──────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# ── Web research (fallback path) ───────────────────────────────────
TAVILY_API_KEY=
# Comma-separated allow-list of official domains for live web search.
WEB_ALLOWLIST=gov.lk

# ── Embeddings (local, no API) ─────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── RAG guardrails ─────────────────────────────────────────────────
# Confidence serving gate (AD-8 / docs 05). Below this, auto_gathered facts
# are NOT rendered — the graceful fallback is returned instead.
CONFIDENCE_THRESHOLD=0.6
# Self-expanding RAG loop cap (AD-2 / docs 03).
MAX_ACQUISITION_LOOPS=2

# ── LLM gateway (rate limiting, AD-10) ─────────────────────────────
LLM_RATE_LIMIT_RPM=15

# ── Observability (optional) ───────────────────────────────────────
# LangSmith tracing is off unless BOTH the flag is true AND a key is set.
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false
# Trace project name (defaults to "govguide" when tracing is on).
LANGSMITH_PROJECT=govguide
